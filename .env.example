# Original Track A PostgreSQL pipeline
DB_HOST=localhost
DB_PORT=5432
DB_NAME=retailflow
DB_USER=postgres
DB_PASSWORD=replace_with_your_local_password

# Optional AWS data lake integration for RetailFlow 2.0.
# AWS credentials must come from the active AWS Academy Learner Lab session
# or another supported AWS credential provider. Do NOT put access keys here.
RETAILFLOW_AWS_ENABLED=false
RETAILFLOW_AWS_REGION=ap-south-1
RETAILFLOW_AWS_BUCKET=replace-with-an-existing-s3-bucket
RETAILFLOW_AWS_PREFIX=retailflow
RETAILFLOW_GLUE_DATABASE=retailflow
RETAILFLOW_ATHENA_WORKGROUP=primary
# Defaults to s3://<bucket>/<prefix>/athena-results/ when left empty.
RETAILFLOW_ATHENA_OUTPUT_LOCATION=
# Product images can increase storage usage; disabled by default.
RETAILFLOW_AWS_UPLOAD_IMAGES=false
